Below is a consolidated SAS testing template you can adapt.

```sas
/* MOD13895 Core Data Quality Testing */

/* 1. Primary key uniqueness */
proc sql;
create table dq_dup_app_applicant as
select application_nbr, applicant_nbr, count(*) as cnt
from sb_data.sb_card_data_processed
group by application_nbr, applicant_nbr
having calculated cnt > 1;
quit;

/* 2. Required CDE completeness */
proc means data=sb_data.sb_card_data_processed n nmiss;
var application_nbr applicant_nbr application_dt vintage
    CIDS_Blend_Score_v2 Vantage4_Score booked_flg wt;
run;

/* 3. Valid score ranges */
proc sql;
create table dq_score_range as
select *
from sb_data.sb_card_data_processed
where 
   (CIDS_Blend_Score_v2 ne . and not (397 <= CIDS_Blend_Score_v2 <= 695))
or (CIDS_Comm_Score_v2  ne . and not (419 <= CIDS_Comm_Score_v2  <= 669))
or (Vantage4_Score      ne . and not (300 <= Vantage4_Score      <= 850));
quit;

/* 4. Excluded invalid records check */
proc sql;
create table dq_invalid_should_exclude as
select *
from sb_data.sb_card_data_processed
where CIDS_Blend_Score_v2 = 0
   or CIDS_Comm_Score_v2 = 0
   or Vantage4_Score = 1;
quit;

/* 5. Weight check: application-level guarantor count */
proc sql;
create table dq_weight_check as
select a.application_nbr,
       count(distinct a.applicant_nbr) as applicant_cnt,
       sum(a.wt) as sum_wt,
       min(a.wt) as min_wt,
       max(a.wt) as max_wt
from sb_data.sb_card_data_processed a
group by a.application_nbr
having abs(calculated sum_wt - 1) > 1e-8;
quit;

/* 6. Booked / approved logic reasonableness */
proc freq data=sb_data.sb_card_data_dev;
tables booked_flg*approval_ind final_decision*approval_ind / missing;
run;

/* 7. Target flag validity */
proc freq data=sb_data.sb_card_data_dev;
tables bad60_3m bad60_6m bad60_9m bad60_12m bad60_15m bad60_18m bad60_21m bad60_24m / missing;
run;

/* 8. Bad flag monotonicity across windows */
data dq_bad_window_nonmono;
set sb_data.sb_card_data_dev;
if bad60_3m > bad60_6m or bad60_6m > bad60_9m or bad60_9m > bad60_12m or
   bad60_12m > bad60_15m or bad60_15m > bad60_18m or bad60_18m > bad60_21m or
   bad60_21m > bad60_24m;
run;

/* 9. Booked records: target should come from internal performance */
proc sql;
create table dq_booked_target_missing as
select *
from sb_data.sb_card_data_dev
where booked_flg='Y' and bad60_24m is missing;
quit;

/* 10. Non-booked proxy performance coverage */
proc freq data=sb_data.sb_card_data_dev;
tables population_ind*bad60_24m / missing;
run;

proc sql;
create table dq_proxy_coverage as
select vintage,
       count(*) as nonbooked_cnt,
       sum(case when population_ind='NOT BOOKED WITH PROXY' then 1 else 0 end) as proxy_cnt,
       calculated proxy_cnt / calculated nonbooked_cnt as proxy_coverage format=percent8.2
from sb_data.sb_card_data_dev
where booked_flg ne 'Y'
group by vintage;
quit;

/* 11. Vintage eligibility / sample split */
proc freq data=sb_data.sb_card_data_dev;
tables archive_dt*vintage / missing;
run;

proc sql;
select count(*) as dev_cnt from sb_data.sb_card_data_dev;
select count(*) as insample_cnt from sb_data.sb_card_data_insample;
select count(*) as holdout_cnt from sb_data.sb_card_data_holdout;
select count(*) as oot_cnt from sb_data.sb_card_data_oot;
quit;

/* 12. Training / holdout split ratio and bad-rate preservation */
proc sql;
create table dq_split_check as
select vintage, bad60_24m,
       sum(case when urn in (select urn from sb_data.sb_card_data_insample) then 1 else 0 end) as train_cnt,
       sum(case when urn in (select urn from sb_data.sb_card_data_holdout) then 1 else 0 end) as holdout_cnt,
       calculated train_cnt / (calculated train_cnt + calculated holdout_cnt) as train_pct format=percent8.2
from sb_data.sb_card_data_dev
group by vintage, bad60_24m;
quit;

/* 13. Missing score coverage by vintage */
proc sql;
create table dq_score_coverage as
select vintage,
       count(*) as total_cnt,
       sum(CIDS_Blend_Score_v2 ne .) as cids_cnt,
       sum(Vantage4_Score ne .) as vantage_cnt,
       sum(CIDS_Blend_Score_v2 ne . and Vantage4_Score ne .) as both_cnt,
       calculated cids_cnt / calculated total_cnt as cids_cov format=percent8.2,
       calculated vantage_cnt / calculated total_cnt as vantage_cov format=percent8.2,
       calculated both_cnt / calculated total_cnt as both_cov format=percent8.2
from sb_data.sb_card_data_dev
group by vintage;
quit;

/* 14. Missing-score scenario coverage */
proc freq data=sb_data.sb_card_data_dev;
tables CIDS_Blend_FLAG*Vantage4_FLAG / missing;
run;

/* 15. Imputation reasonableness */
proc sql;
create table dq_impute_check as
select *
from sb_card_data_insample_impute
where (CIDS_Blend_Score_v2 = . and Vantage4_Score = .)
   or (CIDS_Blend_Score_v2 = . and CIDS_BLEND_v2_local_fit = .)
   or (Vantage4_Score = . and Vantage_local_fit = .);
quit;

/* 16. Local fit monotonicity: bad rate should decrease as score increases */
proc sort data=sb_out.CIDS_BLENDED_v2_local_fit2 out=cids_fit;
by predictor;
run;

data dq_cids_nonmono;
set cids_fit;
prev_fit = lag(localfit);
if _n_ > 1 and localfit > prev_fit then output;
run;

proc sort data=sb_out.Vantage4_local_fit2 out=v4_fit;
by predictor;
run;

data dq_vantage_nonmono;
set v4_fit;
prev_fit = lag(localfit);
if _n_ > 1 and localfit > prev_fit then output;
run;

/* 17. Final score / PD sanity */
data dq_pd_check;
set sb_card_scored_calib2;
pd = exp(default)/(1+exp(default));
if pd < 0 or pd > 1 or pd = . then output;
run;

/* 18. Conservative calibration target check: booked in-time PD around 8% */
proc sql;
select sum(pd*wt)/sum(wt) as avg_pd format=percent8.2
from sb_card_scored_intime_booked3;
quit;

/* 19. Count and bad-rate by vintage for reconciliation */
proc sql;
create table dq_vintage_summary as
select vintage,
       population_ind,
       count(*) as cnt,
       sum(wt) as wt_cnt,
       sum(bad60_24m*wt)/sum(wt) as bad_rate_24m format=percent8.2,
       sum(CIDS_Blend_Score_v2 ne .)/count(*) as cids_cov format=percent8.2,
       sum(Vantage4_Score ne .)/count(*) as v4_cov format=percent8.2
from sb_data.sb_card_data_dev
group by vintage, population_ind;
quit;

/* 20. Output all exceptions */
proc print data=dq_dup_app_applicant(obs=50); title "Duplicate App/Applicant"; run;
proc print data=dq_score_range(obs=50); title "Score Range Exceptions"; run;
proc print data=dq_invalid_should_exclude(obs=50); title "Invalid Exclusion Exceptions"; run;
proc print data=dq_weight_check(obs=50); title "Weight Exceptions"; run;
proc print data=dq_bad_window_nonmono(obs=50); title "Bad Window Non-Monotonicity"; run;
proc print data=dq_booked_target_missing(obs=50); title "Booked Missing Target"; run;
proc print data=dq_impute_check(obs=50); title "Imputation Exceptions"; run;
proc print data=dq_cids_nonmono(obs=50); title "CIDS Local Fit Non-Monotonic"; run;
proc print data=dq_vantage_nonmono(obs=50); title "Vantage Local Fit Non-Monotonic"; run;
```

The most important validator tests are **uniqueness, score range/exclusion, 24-month target construction, proxy coverage, vintage split, missing-score imputation, and calibration-to-8% reasonableness**.
